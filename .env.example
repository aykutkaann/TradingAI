# Copy to .env and fill in.  docker compose reads .env automatically.
# .env is gitignored — that's where REAL secrets go. This file is just the template.

# AI provider (xAI Grok or Groq — pick one and set BaseUrl accordingly)
GROK_API_KEY=your-grok-or-groq-api-key
GROK_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROK_BASE_URL=https://api.groq.com/openai/v1

# TwelveData (forex / commodities / stocks)
TWELVEDATA_API_KEY=your-twelvedata-key

# Email (Mailtrap sandbox by default — fine for local dev)
EMAIL_HOST=sandbox.smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@tradingai.dev

# Generate a fresh long random string for production:
#   PowerShell:  [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Max 256 }))
JWT_SECRET=replace-me-with-a-real-random-secret-at-least-32-chars
